# =============================================================================
#  Cretzo - server secrets template
# =============================================================================
#
# Copy this file to `.env` ON THE SERVER and fill in real values:
#
#     cp .env.example .env
#     nano .env
#
# `.env` is gitignored; this template is not. Never put a real value in this file.
#
# index.php reads `.env` before CodeIgniter boots, so these reach both web requests
# and CLI (`php index.php admin migrate`, the cron jobs). Real environment variables
# set by hPanel or a vhost take precedence over this file - it is a fallback for
# hosts that offer nothing better, not an override.
#
# Format: KEY=value, one per line. `#` starts a comment. Quote the value if it
# contains spaces or a `#`. No interpolation, no multi-line values.
#
# -----------------------------------------------------------------------------
#  WHY EACH OF THESE EXISTS
# -----------------------------------------------------------------------------
# Every one of these was previously a literal inside a git-tracked file, which means
# every previous value is public and must be replaced rather than reused. Generate
# fresh random secrets with:
#
#     php -r "echo bin2hex(random_bytes(32));"


# -- Database ------------------------------------------------------------------
# Was hardcoded in application/config/database.php (a DEPLOYED, TRACKED file), so
# the old password is public. Change it in the hosting panel first, put the new one
# here, confirm the site works, then delete the $legacy_* fallback block from
# database.php and commit that.
DB_HOSTNAME=localhost
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=


# -- Mobile API token signing --------------------------------------------------
# Was hardcoded in application/config/constants.php. Only used for SIGNING by the
# generate_token() endpoints, which are disabled by default
# (api_security.php: allow_public_token_generation). The mobile API VERIFIES tokens
# against the client_api_keys table, so this being unset does not break the app.
#
# Before setting this, run the query in constants.php: if the old published value
# also exists as a row in client_api_keys, that row is a compromised API key and
# must be rotated in the admin panel.
JWT_SECRET_KEY=


# -- CodeIgniter encryption key ------------------------------------------------
# Was empty string. Nothing currently uses the Encryption library, so this is
# precautionary: the first feature that calls $this->encryption->encode() would
# otherwise encrypt with a key everybody knows, silently.
CI_ENCRYPTION_KEY=


# -- Cron secret ---------------------------------------------------------------
# Guards the token-protected jobs in admin/Cron_job.php - including
# settle_seller_commission, which CREDITS SELLER WALLETS, and
# release_referral_rewards. Unset means those endpoints refuse every call, so the
# nightly settlement does not run. Fail-closed, but it does need setting.
#
# The cron URLs must be updated to match:
#   curl -s "https://cretzo.com/admin/cron_job/settle_seller_commission?is_date=1&token=THE_SECRET"
SUBSCRIPTION_CRON_SECRET=


# -- Facebook app secret -------------------------------------------------------
# Was hardcoded in application/config/constants.php, so the old value is public and
# should be rotated in the Facebook developer console. Nothing reads it any more -
# the PHP SDK login flow was removed and Facebook sign-in goes through Firebase,
# which needs no app secret server-side. Kept only so config/facebook.php resolves.
FACEBOOK_APP_SECRET=

# -- Twilio (seller-signup SMS OTP) --------------------------------------------
# Was hardcoded in application/config/twilio.php, so the old auth token is public.
# This one is not just a read credential: whoever holds it can send SMS billed to
# this account, from this account's number - a direct cost and a ready-made phishing
# channel, since the messages arrive from the number Cretzo's own OTPs come from.
#
# Rotate the auth token in the Twilio console, then check the usage log for messages
# you did not send. Unset means the seller OTP send fails and logs why, rather than
# using a published token - and the live OTP channel here is Firebase anyway, so this
# path is a fallback.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=
